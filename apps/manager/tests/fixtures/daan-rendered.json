[
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "name": "bedrock-data-daan",
      "namespace": "minecraft-servers",
      "labels": {
        "app.kubernetes.io/name": "bedrock",
        "app.kubernetes.io/instance": "daan",
        "app.kubernetes.io/component": "storage"
      }
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "storageClassName": "local-path",
      "resources": {
        "requests": {
          "storage": "5Gi"
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "bedrock-daan",
      "namespace": "minecraft-servers",
      "labels": {
        "app.kubernetes.io/name": "bedrock",
        "app.kubernetes.io/instance": "daan"
      }
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "type": "Recreate"
      },
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "bedrock",
          "app.kubernetes.io/instance": "daan"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "bedrock",
            "app.kubernetes.io/instance": "daan"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "bedrock",
              "image": "itzg/minecraft-bedrock-server:latest",
              "imagePullPolicy": "Always",
              "tty": true,
              "stdin": true,
              "env": [
                {
                  "name": "EULA",
                  "value": "TRUE"
                },
                {
                  "name": "VERSION",
                  "value": "LATEST"
                },
                {
                  "name": "TRANSPORT",
                  "value": "raknet"
                },
                {
                  "name": "SERVER_NAME",
                  "value": "Daan"
                },
                {
                  "name": "LEVEL_NAME",
                  "value": "Daan"
                },
                {
                  "name": "GAMEMODE",
                  "value": "adventure"
                },
                {
                  "name": "DIFFICULTY",
                  "value": "peaceful"
                },
                {
                  "name": "ALLOW_CHEATS",
                  "value": "true"
                },
                {
                  "name": "MAX_PLAYERS",
                  "value": "10"
                },
                {
                  "name": "ONLINE_MODE",
                  "value": "true"
                },
                {
                  "name": "ALLOW_LIST",
                  "value": "false"
                },
                {
                  "name": "DEFAULT_PLAYER_PERMISSION_LEVEL",
                  "value": "operator"
                },
                {
                  "name": "LEVEL_SEED",
                  "value": "888882571486312935"
                }
              ],
              "ports": [
                {
                  "name": "bedrock",
                  "containerPort": 19132,
                  "protocol": "UDP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "250m",
                  "memory": "512Mi"
                },
                "limits": {
                  "memory": "2Gi"
                }
              },
              "volumeMounts": [
                {
                  "name": "data",
                  "mountPath": "/data"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "data",
              "persistentVolumeClaim": {
                "claimName": "bedrock-data-daan"
              }
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "bedrock-daan",
      "namespace": "minecraft-servers",
      "labels": {
        "app.kubernetes.io/name": "bedrock",
        "app.kubernetes.io/instance": "daan"
      }
    },
    "spec": {
      "type": "ClusterIP",
      "selector": {
        "app.kubernetes.io/name": "bedrock",
        "app.kubernetes.io/instance": "daan"
      },
      "ports": [
        {
          "name": "bedrock",
          "port": 19132,
          "targetPort": "bedrock",
          "protocol": "UDP"
        }
      ]
    }
  },
  {
    "apiVersion": "traefik.io/v1alpha1",
    "kind": "IngressRouteUDP",
    "metadata": {
      "name": "bedrock-daan",
      "namespace": "minecraft-servers",
      "labels": {
        "app.kubernetes.io/name": "bedrock",
        "app.kubernetes.io/instance": "daan"
      }
    },
    "spec": {
      "entryPoints": [
        "mc-daan"
      ],
      "routes": [
        {
          "services": [
            {
              "name": "bedrock-daan",
              "port": 19132
            }
          ]
        }
      ]
    }
  }
]
