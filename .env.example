# MANAGER_SECRET and NUXT_MANAGER_SECRET must match and be >= 32 characters.
MANAGER_SECRET=replace-with-a-random-secret-of-32-chars-or-more
MANAGER_HOST=127.0.0.1
MANAGER_PORT=3001
NUXT_MANAGER_URL=http://127.0.0.1:3001
NUXT_MANAGER_SECRET=replace-with-a-random-secret-of-32-chars-or-more
# Web sign-in operators: JSON array of { "username", "passwordHash" }; create a hash with
# `printf %s '<password>' | pnpm --filter web hash-password`; paste the hash as-is inside the single quotes. Empty list = nobody can sign in (fail closed).
NUXT_AUTH_USERS='[]'
# Set to true ONLY behind a trusted reverse proxy/ingress that sets X-Forwarded-For; otherwise
# every operator shares the proxy IP and the per-IP lockout blocks everyone.
NUXT_AUTH_TRUST_PROXY=false
# Cluster access for the manager (kubectl must be installed on the manager host).
# Namespace the manager is allowed to touch (the Traefik HelmChartConfig in kube-system is the only exception).
MC_NAMESPACE=minecraft-servers
# Optional: kubeconfig context and file; unset = kubectl defaults.
#KUBE_CONTEXT=
#KUBECONFIG=
KUBECTL_BIN=kubectl
# Public UDP port range for new servers.
MC_PORT_MIN=19132
MC_PORT_MAX=19999
# Cluster poll interval in ms (>= 500).
MC_POLL_MS=3000
